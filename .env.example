# Copy this file to .env and fill in the keys you need.
# Only the keys for the providers/tools you actually select are required.

# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Route OpenAI model strings (e.g. openai:gpt-4.1) through OpenRouter instead ---
# OPENROUTER_API_KEY=
# USE_OPENROUTER_FOR_OPENAI=true
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Search APIs ---
TAVILY_API_KEY=
# EXA_API_KEY=
# LINKUP_API_KEY=

# --- LangSmith tracing (optional) ---
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=deeprewind

# --- Research/epistemic-graph recording (fork additions, on by default) ---
# ENABLE_RESEARCH_LOGGING=true
# RESEARCH_LOG_DIR=research_logs
# ENABLE_EPISTEMIC_GRAPH=true
# EPISTEMIC_GRAPH_DIR=epistemic_graphs

# --- DeepRewind world-model control layer (off by default) ---
# ENABLE_WORLD_MODEL=false
# WORLD_MODEL_LOG_DIR=world_model_logs
